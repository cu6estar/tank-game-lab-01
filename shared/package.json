{
  "name": "@tank/shared",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Симуляція, протокол і кодеки — один код для браузера й Node. Без DOM, без node:*.",
  "exports": {
    "./*": "./src/*"
  },
  "scripts": {
    "test": "vitest run",
    "hash": "node -e \"import('./src/scenario.ts').then(({runScenario})=>console.log(runScenario({seed:20260,steps:1000}).hashes))\"",
    "hash:chrome": "node tools/hash-chrome.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "bench:sim": "node tools/bench-sim.ts",
    "bench:load": "node tools/bench-load.ts",
    "bench:collision": "node tools/bench-collision.ts",
    "exp:worker": "node experiments/worker-offload.ts"
  },
  "dependencies": {
    "zod": "^3.25.76"
  }
}
